{
    "printWidth": 80,
    "tabWidth": 4,
    "useTabs": true,
    "semi": true,
    "singleQuote": true,
    "quoteProps": "consistent",
    "jsxSingleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": true,
    "objectWrap": "preserve",
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "lf",
    "requirePragma": false,
    "insertPragma": false,
    "checkIgnorePragma": true,
    "proseWrap": "always",
    "embeddedLanguageFormatting": "auto",
    "singleAttributePerLine": true
}