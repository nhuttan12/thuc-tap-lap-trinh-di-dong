<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            xmlns:tools="http://schemas.android.com/tools"
            android:id="@+id/admin_nav_graph"
            app:startDestination="@id/loginFragment">


    <fragment
            android:id="@+id/loginFragment"
            android:name="com.example.admin.fragment.LoginFragment"
            android:label="Login"
            tools:layout="@layout/fragment_login" />

    <!-- 1. Dashboard – Màn chính -->

    <fragment
            android:id="@+id/dashboardFragment"
            android:name="com.example.admin.fragment.DashboardFragment"
            android:label="Tổng quan"
            tools:layout="@layout/fragment_admin_dashboard">

        <!-- Dashboard → Analytics -->
        <action
                android:id="@+id/action_dashboard_to_analytics"
                app:destination="@id/analyticsFragment"
                app:enterAnim="@anim/slide_in_right"
                app:exitAnim="@anim/slide_out_left"
                app:popEnterAnim="@anim/slide_in_left"
                app:popExitAnim="@anim/slide_out_right" />

        <!-- ✅ Dashboard → Product List -->
        <action
                android:id="@+id/action_dashboard_to_products"
                app:destination="@id/productListFragment" />

        <!-- (nếu cần) Dashboard → Orders -->
        <action
                android:id="@+id/action_dashboard_to_orders"
                app:destination="@id/orderListFragment" />

    </fragment>


    <!-- 2. Thống kê chi tiết -->
    <fragment
            android:id="@+id/analyticsFragment"
            android:name="com.example.admin.fragment.AnalyticsFragment"
            android:label="Thống kê chi tiết"
            tools:layout="@layout/fragment_analytics">

        <!-- Từ Analytics → về lại Dashboard  -->
        <action
                android:id="@+id/action_analytics_to_dashboard"
                app:destination="@id/dashboardFragment"
                app:popUpTo="@id/dashboardFragment"
                app:popUpToInclusive="true" />
        <!-- popUpToInclusive="true" để xóa Analytics khỏi stack → back  -->
    </fragment>

    <!-- 3. Các màn CRUD -->

    <fragment
            android:id="@+id/productListFragment"
            android:name="com.example.admin.fragment.ProductListFragment"
            android:label="Sản phẩm"
            tools:layout="@layout/fragment_product_list">


        <action
                android:id="@+id/action_productList_to_productForm"
                app:destination="@id/productFormFragment">
            <argument
                    android:name="isEditMode"
                    app:argType="boolean" />
            <argument
                    android:name="productId"
                    app:argType="integer"
                    android:defaultValue="0" />
        </action>
    </fragment>

    <fragment
            android:id="@+id/productFormFragment"
            android:name="com.example.admin.fragment.ProductFormFragment"
            android:label="Thêm/Sửa sản phẩm"
            tools:layout="@layout/fragment_product_form">

        <argument
                android:name="isEditMode"
                app:argType="boolean"
                android:defaultValue="false" />

        <argument
                android:name="productId"
                app:argType="integer"
                android:defaultValue="0" />
    </fragment>



    <fragment
            android:id="@+id/orderListFragment"
            android:name="com.example.admin.fragment.OrderListFragment"
            android:label="Đơn hàng"
            tools:layout="@layout/fragment_order_list" />

    <fragment
            android:id="@+id/userListFragment"
            android:name="com.example.admin.fragment.UserListFragment"
            android:label="Người dùng"
            tools:layout="@layout/fragment_user_list">

        <action
                android:id="@+id/action_userList_to_userForm"
                app:destination="@id/userFormFragment">
            <argument
                    android:name="isEditMode"
                    app:argType="boolean"
                    android:defaultValue="false" />
            <argument
                    android:name="userId"
                    app:argType="integer"
                    android:defaultValue="0" />
        </action>
    </fragment>

    <fragment
            android:id="@+id/userFormFragment"
            android:name="com.example.admin.fragment.UserFormFragment"
            android:label="Thêm/Sửa người dùng"
            tools:layout="@layout/fragment_user_form">

        <argument
                android:name="isEditMode"
                app:argType="boolean"
                android:defaultValue="false" />

        <argument
                android:name="userId"
                app:argType="integer"
                android:defaultValue="0" />
    </fragment>


</navigation>