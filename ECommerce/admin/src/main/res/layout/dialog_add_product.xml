<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">

    <EditText android:id="@+id/etName" android:hint="Tên sản phẩm"  android:layout_height="4dp" android:layout_width="4dp"/>
    <EditText android:id="@+id/etPrice" android:hint="Giá" android:inputType="number"  android:layout_height="4dp" android:layout_width="4dp"/>
    <EditText android:id="@+id/etBrand" android:hint="Thương hiệu"  android:layout_height="4dp" android:layout_width="4dp"/>

</LinearLayout>